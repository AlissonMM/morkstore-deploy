# Copie para ".env" e ajuste. Sem .env, o compose usa os defaults de teste local.
# NUNCA commite o .env real.

# --- Banco ---
MYSQL_ROOT_PASSWORD=troque-esta-senha

# --- Admin criado no primeiro start da API ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_EMAIL=admin@seudominio.com

# --- Endereço público (o que o visitante digita no navegador) ---
# Na VM, troque localhost pelo IP público ou domínio.
FRONTEND_ORIGIN=http://localhost:4200
PUBLIC_API_URL=http://localhost:8080
PUBLIC_ANALYTICS_URL=http://localhost:8091

# Porta em que o site é publicado (use 80 na VM).
FRONTEND_PORT=4200
